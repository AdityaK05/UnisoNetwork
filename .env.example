# UNISO BUDDY - Root Environment Variables (.env.example)
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/uniso
DATABASE_POOL_SIZE=10
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-here-min-32-characters
SESSION_SECRET=your-session-secret-key-here

# ============================================
# CORS & FRONTEND
# ============================================
CORS_ORIGIN=http://localhost:5173
# Production: CORS_ORIGIN=https://uniso.example.com

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
# Options: development, staging, production
