# UNISO BUDDY - Server Environment Variables (server/.env.example)
# Copy this file to server/.env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/uniso

# ============================================
# LLM & AI SERVICES
# ============================================

# Anthropic Claude (REQUIRED)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048

# OpenAI (Optional - for advanced embeddings)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# VECTOR DATABASE & RAG
# ============================================
EMBEDDING_SERVICE=mock
# Options: mock (dev), openai (production)

STORE_EMBEDDINGS_IN_DB=true
VECTOR_DB_DIMENSION=1024
VECTOR_DB_SIMILARITY_THRESHOLD=0.5

# RAG Settings
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR=uploads/buddy-documents/
MAX_FILE_SIZE=52428800
# Allowed: pdf, docx, doc, txt, xlsx, xls
ALLOWED_FILE_TYPES=pdf,docx,doc,txt,xlsx,xls

# Cloudinary (Optional)
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================
# EMAIL & SMS SERVICES
# ============================================

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@uniso.example.com

# Twilio SMS & Phone Verification
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxx

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BUDDY_CHAT_RATE_LIMIT=30
BUDDY_DOCUMENT_UPLOAD_LIMIT=10
BUDDY_COVER_LETTER_LIMIT=5

# ============================================
# SERVER CONFIG
# ============================================
PORT=3000
HOST=localhost
LOG_LEVEL=debug
# Options: debug, info, warn, error

ENABLE_CORS=true
ENABLE_RATE_LIMITING=true

# ============================================
# CAREER & PERSONALIZATION
# ============================================
ENABLE_SKILL_RECOMMENDATIONS=true
ENABLE_PROJECT_IDEAS=true
ENABLE_INTERVIEW_PREP=true
DEFAULT_EXPERIENCE_YEARS=0
DEFAULT_EDUCATION_LEVEL=bachelor

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-here-min-32-characters
SESSION_SECRET=your-session-secret-key-here
