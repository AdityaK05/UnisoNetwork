# UNISO BUDDY - Free Stack Configuration
# Complete environment variables for 100% FREE setup
# 
# Cost: $0/month (All services are free or use free tiers)
# Setup Time: ~1 hour
# 
# For detailed setup instructions, see:
# - BUDDY_FREE_STACK_SUMMARY.md (quick start)
# - BUDDY_FREE_ALTERNATIVES.md (detailed guide)
# - BUDDY_ENV_VARIABLES_COMPLETE.md (all variables)

# ============================================
# DATABASE (Free - Local PostgreSQL)
# ============================================
# Setup: https://www.postgresql.org/download/
# After install:
#   createdb uniso
#   psql -d uniso -f server/db/schema.sql

DATABASE_URL=postgresql://postgres:your-password@localhost:5432/uniso

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Generate with: openssl rand -base64 32

JWT_SECRET=generate-a-random-32-character-secret-key-here!!!
SESSION_SECRET=generate-another-random-secret-key-here!!!
JWT_EXPIRES_IN=7d

# ============================================
# SERVER CONFIGURATION
# ============================================

PORT=3000
HOST=localhost
NODE_ENV=development

# Logging
LOG_LEVEL=debug
# Options: debug, info, warn, error, silent

# CORS
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:5173

# ============================================
# LLM - FREE STACK (Ollama)
# ============================================
# Setup:
#   1. Download from https://ollama.ai
#   2. Run: ollama serve (in separate terminal)
#   3. Pull model: ollama pull llama2
#   
# Available models:
#   - llama2 (recommended, balanced)
#   - mistral (faster)
#   - neural-chat (conversational)
#   - orca-mini (smallest, 3B)

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/api
LLM_MODEL=llama2

# Model parameters
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ============================================
# EMBEDDINGS - FREE STACK (Sentence Transformers)
# ============================================
# Setup:
#   1. Install: pip install sentence-transformers flask
#   2. Run server: python server/services/embedding_server.py (separate terminal)
#   
# Available models:
#   - all-MiniLM-L6-v2 (recommended, fast, 22MB)
#   - all-mpnet-base-v2 (best quality, 420MB)
#   - distiluse-base-multilingual (multilingual, 135MB)

EMBEDDING_SERVICE=sentence-transformers
EMBEDDING_SERVER_URL=http://localhost:5000
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Store embeddings in database for persistence
STORE_EMBEDDINGS_IN_DB=true
VECTOR_DB_DIMENSION=384
VECTOR_DB_SIMILARITY_THRESHOLD=0.5

# ============================================
# RAG SETTINGS (Document Q&A)
# ============================================

# How many characters per chunk when splitting documents
CHUNK_SIZE=1024

# Overlap between chunks (for context continuity)
CHUNK_OVERLAP=100

# How many top results to return from vector search
RAG_TOP_K=5

# Minimum similarity score (0-1) for matching documents
RAG_MIN_SIMILARITY=0.5

# Use hybrid search (both vector + keyword matching)
RAG_USE_HYBRID_SEARCH=true

# ============================================
# FILE STORAGE - FREE STACK (Local)
# ============================================
# Setup: Just creates ./uploads folder

FILE_STORAGE=local
UPLOAD_DIR=./uploads/buddy-documents

# Upload limits
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,doc,txt,xlsx,xls

# ============================================
# EMAIL - FREE STACK (Resend)
# ============================================
# Setup:
#   1. Sign up (FREE, no card): https://resend.com
#   2. Get API key from dashboard
#   3. Free tier: 100 emails/day
#   
# Alternative: Set EMAIL_SERVICE=console to just log emails

EMAIL_SERVICE=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=buddy@example.com
EMAIL_FROM_NAME=UNISO BUDDY

# ============================================
# SMS & PHONE VERIFICATION (Optional)
# ============================================
# Setup Option 1 - Console (just logs):
#   EMAIL_SERVICE=console
#
# Setup Option 2 - Twilio Free Trial ($15.50 credit):
#   1. Sign up: https://www.twilio.com/try-twilio
#   2. Get Account SID, Auth Token
#   3. Create Verify Service
#   4. Get a phone number

SMS_SERVICE=console
# SMS_SERVICE=twilio  # Uncomment to use Twilio trial
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_VERIFY_SID=VAxxxxxxxxxxxxx

# ============================================
# BUDDY FEATURES
# ============================================

ENABLE_SKILL_RECOMMENDATIONS=true
ENABLE_PROJECT_IDEAS=true
ENABLE_INTERVIEW_PREP=true
ENABLE_COVER_LETTER_GENERATION=true

# ============================================
# RATE LIMITING (Optional)
# ============================================

ENABLE_RATE_LIMITING=false  # Set to true in production

# Per-user rate limits
BUDDY_CHAT_RATE_LIMIT=30        # messages per 15 minutes
BUDDY_DOCUMENT_UPLOAD_LIMIT=10  # uploads per day
BUDDY_COVER_LETTER_LIMIT=5      # letters per day

# ============================================
# CONVERSATION SETTINGS
# ============================================

KEEP_CONVERSATION_HISTORY=true
CONVERSATION_HISTORY_LIMIT=50
SESSION_TIMEOUT=3600000  # 1 hour

# ============================================
# BUDDY DEFAULTS
# ============================================

DEFAULT_EXPERIENCE_YEARS=0
DEFAULT_EDUCATION_LEVEL=bachelor
# Options: high_school, bachelor, master, phd

# ============================================
# ADVANCED - Not needed for basic setup
# ============================================

# Enable detailed logging
DEBUG_MODE=false

# Development/testing options
MOCK_VERIFICATION=false
FORCE_SMS_SKIP=false

